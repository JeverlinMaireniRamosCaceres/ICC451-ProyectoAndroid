<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/bubbleRecibido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bbj_rec"
        android:padding="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtMensajeRec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hola, ¿cómo estás?"
            android:textColor="@color/colorTextoPrimario"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtHoraRec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="10:30"
            android:textColor="@color/colorTextoSecundario"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>